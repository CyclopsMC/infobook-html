mixin brand
    if bookIcon || icon
        img(class="site-book-icon", src=(bookIcon || icon), alt="")
    span
        span(class="site-mod")=modName
        span(class="site-book")=bookName

header(class="site-header")
    meta(property="schema:name", content=modName + ' - ' + bookName)
    if breadcrumbs && breadcrumbs.length > 0 && breadcrumbs[0].url
        a(class="site-brand", href=breadcrumbs[0].url)
            +brand
    else
        div(class="site-brand")
            +brand

    div(class="site-tools")
        if search
            pagefind-modal-trigger(placeholder="Search")
        details(class="languages")
            summary=language
            ul
                each lang in languages
                    li
                        if lang.name === language
                            a(href=lang.url, aria-current="page") !{lang.name}
                        else
                            a(href=lang.url) !{lang.name}
