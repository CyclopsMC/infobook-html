doctype html
html(lang=languageTag)
    head
        include includes/head.pug
        title=modName + ' - ' + bookName + ' - ' + sectionTitle
    body(vocab=baseUrl)
        include includes/header.pug
        include includes/search.pug

        div(class="main-outer")
            section(class="main", data-pagefind-body)
                div(data-pagefind-ignore)
                    include includes/breadcrumbs.pug
                h1 !{sectionTitle}
                hr(class="ornament")
                ul(class="toc")
                    each val in subSectionDatas
                        li
                            a(href=val.url) !{val.sectionTitle}
                div(data-pagefind-ignore)
                    include includes/main-footer.pug

        include includes/footer.pug
